<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
<!-- The hardened runtime, required for notarization, blocks the camera sources
     without this. Add nothing here that MapMap does not need. -->
<key>com.apple.security.device.camera</key>
<true/>
</dict>
</plist>
